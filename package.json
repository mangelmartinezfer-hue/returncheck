{
  "name": "returncheck",
  "version": "1.0.0",
  "description": "ReturnCheck verifies which return policy actually applies to this purchase. API and MCP tool for shopping agents.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "validate": "node tools/preflight/runner.mjs all",
    "validate:payment": "node tools/preflight/runner.mjs payment",
    "validate:ucp": "node tools/preflight/runner.mjs ucp",
    "validate:corpus": "node tools/preflight/runner.mjs corpus",
    "test:preflight": "node --test test/preflight.test.mjs",
    "pretest": "npm run validate",
    "check": "node tools/preflight/check.mjs",
    "work:new": "node tools/preflight/new-job.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.14"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
